# Skopíruj do .env.local a doplň hodnoty. .env.local sa necommituje.

# Verejná adresa aplikácie
APP_URL=http://localhost:3000

# MongoDB Atlas (dev databáza). Produkčné hodnoty sú len vo Vercel.
MONGODB_URI=
MONGODB_DB=rozvojklubu_dev

# Sportnet API (fáza F2)
SPORTNET_API_URL=
SPORTNET_API_KEY=

# Prihlasovanie (Better Auth) – v produkcii povinné, min. 32 znakov (napr. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# E-maily (oddelené čiarkou), ktoré pri prvom prihlásení dostanú rolu admin_sfz
INITIAL_ADMIN_EMAILS=

# Sportnet OIDC (auth.sportnet.online) – bez týchto hodnôt je tlačidlo Sportnet skryté
SPORTNET_AUTH_URL=https://auth.sportnet.online
SPORTNET_OAUTH_CLIENT_ID=
SPORTNET_OAUTH_CLIENT_SECRET=

# Ecomail (prihlasovacie e-maily) – bez kľúča sa v dev režime odkaz len vypíše do logu
ECOMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Rozvoj klubu SFZ

# GitHub Packages – token (classic, len read:packages) pre @slovensky-futbalovy-zvaz/design-system (ADR 0016).
# Číta ho .npmrc pri npm install / npm ci. Vercel: Production, Preview, Development; GitHub: Actions aj Dependabot secrets.
# Lokálne stačí: export NPM_GITHUB_TOKEN=$(gh auth token)
NPM_GITHUB_TOKEN=
